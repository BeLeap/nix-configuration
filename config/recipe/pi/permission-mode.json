{
  "$schema": "https://raw.githubusercontent.com/wynainfo/pi-permission-modes/v2.2.0/schemas/permission-mode.schema.json",
  "defaultMode": "build",
  "cycleOrder": [
    "default",
    "plan",
    "build",
    "yolo"
  ],
  "modes": {
    "default": {
      "sandbox": {
        "enabled": true,
        "writable": true,
        "allowWrite": [
          ".",
          "/tmp",
          "~/.config/jj"
        ],
        "denyRead": [
          "~/.ssh",
          "~/.aws",
          "~/.gnupg",
          "~/.pi/agent",
          ".env",
          ".env.*",
          "**/.env",
          "**/.env.*",
          ".envrc*",
          "**/.envrc*",
          ".direnv/**",
          "**/.direnv/**"
        ],
        "network": {
          "allowedDomains": [
            "sandbox-proxy-bootstrap.invalid"
          ],
          "deniedDomains": []
        },
        "askOnBlockedHost": true
      },
      "permission": {
        "external_directory": {
          "*": "ask",
          "~/.agent/skills": "allow",
          "~/.agent/skills/**": "allow"
        },
        "tool": {
          "*": "ask",
          "resolve-library-id": "allow",
          "query-docs": "allow"
        },
        "skill": {
          "*": "ask",
          "context7-docs": "allow"
        },
        "path": {
          "*": "allow",
          ".env": "deny",
          ".env.*": "deny",
          "**/.env": "deny",
          "**/.env.*": "deny",
          ".envrc*": "deny",
          "**/.envrc*": "deny",
          ".direnv/**": "deny",
          "**/.direnv/**": "deny"
        }
      }
    },
    "plan": {
      "sandbox": {
        "enabled": true,
        "writable": false,
        "allowWrite": [
          ".",
          "/tmp",
          "~/.config/jj"
        ],
        "denyRead": [
          "~/.ssh",
          "~/.aws",
          "~/.gnupg",
          "~/.pi/agent",
          ".env",
          ".env.*",
          "**/.env",
          "**/.env.*",
          ".envrc*",
          "**/.envrc*",
          ".direnv/**",
          "**/.direnv/**"
        ],
        "network": {
          "allowedDomains": [],
          "deniedDomains": []
        },
        "askOnBlockedHost": true
      },
      "permission": {
        "external_directory": {
          "*": "ask",
          "~/.agent/skills": "allow",
          "~/.agent/skills/**": "allow"
        },
        "tool": {
          "*": "ask",
          "resolve-library-id": "allow",
          "query-docs": "allow"
        },
        "skill": {
          "*": "ask",
          "context7-docs": "allow"
        },
        "path": {
          "*": "allow",
          ".env": "deny",
          ".env.*": "deny",
          "**/.env": "deny",
          "**/.env.*": "deny",
          ".envrc*": "deny",
          "**/.envrc*": "deny",
          ".direnv/**": "deny",
          "**/.direnv/**": "deny"
        }
      }
    },
    "build": {
      "sandbox": {
        "enabled": true,
        "writable": true,
        "allowWrite": [
          ".",
          "/tmp",
          "~/.config/jj"
        ],
        "denyRead": [
          "~/.ssh",
          "~/.aws",
          "~/.gnupg",
          "~/.pi/agent",
          ".env",
          ".env.*",
          "**/.env",
          "**/.env.*",
          ".envrc*",
          "**/.envrc*",
          ".direnv/**",
          "**/.direnv/**"
        ],
        "network": {
          "allowedDomains": [],
          "deniedDomains": []
        },
        "askOnBlockedHost": true
      },
      "permission": {
        "external_directory": {
          "*": "ask",
          "~/.agent/skills": "allow",
          "~/.agent/skills/**": "allow"
        },
        "tool": {
          "*": "allow",
          "resolve-library-id": "allow",
          "query-docs": "allow"
        },
        "skill": {
          "*": "allow",
          "context7-docs": "allow"
        },
        "path": {
          "*": "allow",
          ".env": "deny",
          ".env.*": "deny",
          "**/.env": "deny",
          "**/.env.*": "deny",
          ".envrc*": "deny",
          "**/.envrc*": "deny",
          ".direnv/**": "deny",
          "**/.direnv/**": "deny"
        }
      }
    }
  }
}
