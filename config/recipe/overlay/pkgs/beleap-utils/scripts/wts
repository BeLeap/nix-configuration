set -euo pipefail

workspace_root="$HOME/ws"
if [[ ! -d "$workspace_root" ]]; then
  printf 'wts: workspace directory does not exist: %s\n' "$workspace_root" >&2
  exit 1
fi

query="$*"
new_session_option='New Session'

list_workspace_options() {
  find "$workspace_root" -mindepth 1 -maxdepth 1 -type d -print0 |
    while IFS= read -r -d '' directory; do
      basename "$directory"
    done || return

  printf '%s\n' "$new_session_option"
}

if workspace_options=$(list_workspace_options); then
  :
else
  list_status=$?
  printf 'wts: could not list workspace options with exit status %s\n' "$list_status" >&2
  exit "$list_status"
fi

if selection_output=$(
  printf '%s\n' "$workspace_options" | fzf --query "$query" --prompt='wts> '
); then
  :
else
  selection_status=$?
  if [[ "$selection_status" -eq 1 || "$selection_status" -eq 130 ]]; then
    exit 0
  fi
  printf 'wts: workspace selection failed with exit status %s\n' "$selection_status" >&2
  exit "$selection_status"
fi

selection="$selection_output"
if [[ -z "$selection" ]]; then
  exit 0
fi

if [[ "$selection" == "$new_session_option" ]]; then
  if ! IFS= read -r -p 'Session name: ' selection; then
    exit 0
  fi
  if [[ -z "$selection" ]]; then
    exit 0
  fi

  name=$(printf '%s' "$selection" | sed 's/ /-/g')
  if [[ "$name" == *"/"* ]]; then
    printf 'wts: workspace name cannot contain /: %s\n' "$selection" >&2
    exit 2
  fi
  if [[ -z "$name" ]]; then
    exit 0
  fi

  workspace_name="$(date +%F)-$name"
  target_dir="$workspace_root/$workspace_name"
  if ! mkdir -- "$target_dir"; then
    printf 'wts: could not create workspace directory: %s\n' "$target_dir" >&2
    exit 1
  fi
else
  target_dir="$workspace_root/$selection"
  if [[ ! -d "$target_dir" ]]; then
    printf 'wts: selected workspace directory does not exist: %s\n' "$target_dir" >&2
    exit 1
  fi
  workspace_name="$selection"
fi

if [[ -z "${WEZTERM_PANE:-}" ]]; then
  if ! wezterm cli spawn --new-window --workspace "$workspace_name" --cwd "$target_dir" >/dev/null; then
    printf 'wts: could not open WezTerm workspace: %s\n' "$workspace_name" >&2
    exit 1
  fi
  exit 0
fi

if ! panes=$(wezterm cli list --format json 2>&1); then
  printf 'wts: could not list WezTerm panes: %s\n' "$panes" >&2
  exit 1
fi

if ! workspace_exists=$(printf '%s\n' "$panes" | jq -r --arg workspace "$workspace_name" 'any(.workspace == $workspace)'); then
  printf 'wts: could not determine whether WezTerm workspace exists: %s\n' "$workspace_name" >&2
  exit 1
fi

if [[ "$workspace_exists" != "true" ]]; then
  if ! wezterm cli spawn --new-window --workspace "$workspace_name" --cwd "$target_dir" >/dev/null; then
    printf 'wts: could not create WezTerm workspace: %s\n' "$workspace_name" >&2
    exit 1
  fi
fi

encoded_name=$(printf '%s' "$workspace_name" | base64 | tr -d '\n')
printf '\033]1337;SetUserVar=DO_FOCUS_WEZTERM_WORKSPACE=%s\007' "$encoded_name"
