#!/usr/bin/env /bin/bash
# shellcheck shell=bash

set -euo pipefail

if [[ $# -gt 1 ]]; then
  printf 'Usage: %s [NAME]\n' "${0##*/}" >&2
  exit 2
fi

name=${1:-}
try_args=()

if [[ -n "$name" ]]; then
  try_args=("$name")
fi

if ! try_commands=$(try exec --path "$HOME/ws" "${try_args[@]}"); then
  printf 'wts: try workspace selection failed\n' >&2
  exit 1
fi

eval "$try_commands"
workspace_dir=$PWD
session_name=${workspace_dir##*/}

if [[ -z "$session_name" ]]; then
  printf 'wts: selected directory has no session name: %s\n' "$workspace_dir" >&2
  exit 1
fi

if [[ -n "${ZELLIJ_SESSION_NAME:-}" ]]; then
  if ! zellij attach --create-background "$session_name"; then
    printf 'wts: failed to create or find Zellij session %s\n' "$session_name" >&2
    exit 1
  fi

  if ! zellij action switch-session --cwd "$workspace_dir" "$session_name"; then
    printf 'wts: failed to switch to Zellij session %s\n' "$session_name" >&2
    exit 1
  fi
  exit 0
fi

cd -- "$workspace_dir"
exec zellij attach --create "$session_name"
