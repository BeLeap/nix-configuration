#!/usr/bin/env /bin/bash
# shellcheck shell=bash

set -euo pipefail

if [[ $# -gt 1 ]]; then
  printf 'Usage: %s [SESSION]\n' "${0##*/}" >&2
  exit 2
fi

name=${1:-}

if [[ -p /dev/stdin ]]; then
  name=$(cat)
fi

if [[ -z "$name" ]]; then
  new_session_option='Create new session'
  name=$(printf '%s\n' "$new_session_option" | wzsf)

  if [[ "$name" == "$new_session_option" ]]; then
    IFS= read -r -p 'Session name: ' name
  fi
fi

if [[ -z "$name" ]]; then
  exit 0
fi

if [[ -n "${ZELLIJ_SESSION_NAME:-}" ]]; then
  if ! zellij attach --create-background "$name"; then
    printf 'wzs: failed to create or find Zellij session %s\n' "$name" >&2
    exit 1
  fi

  if ! zellij action switch-session "$name"; then
    printf 'wzs: failed to switch to Zellij session %s\n' "$name" >&2
    exit 1
  fi
  exit 0
fi

exec zellij attach --create "$name"
