#!/usr/bin/env /bin/bash
# shellcheck shell=bash

set -euo pipefail

sessions=$(zellij list-sessions --short)

if [[ -p /dev/stdin ]]; then
  sessions=$(
    {
      printf '%s\n' "$sessions"
      cat
    } | awk 'NF && !seen[$0]++'
  )
fi

count=$(printf '%s\n' "$sessions" | awk 'NF { count++ } END { print count + 0 }')

case "$count" in
  0)
    exit 0
    ;;
  1)
    printf '%s\n' "$sessions"
    ;;
  *)
    printf '%s\n' "$sessions" | fzf
    ;;
esac
